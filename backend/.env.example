# Servidor
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
# URL pública onde esta API pode ser alcançada pela internet (necessária para
# o Mercado Pago enviar webhooks). Deixe em branco em desenvolvimento local —
# o app funciona normalmente sem webhook, usando consulta direta de status.
# Exemplo em produção: https://api.dravennx.com.br
API_PUBLIC_URL=

# Banco de dados
DATABASE_URL=postgres://postgres:postgres@localhost:5432/blusa_oversized_store
DB_HOST=localhost
DB_PORT=5432
DB_NAME=blusa_oversized_store
DB_USER=postgres
DB_PASSWORD=postgres

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=troque-por-um-segredo-forte
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=troque-por-outro-segredo-forte
JWT_REFRESH_EXPIRES_IN=30d

# Mercado Pago
MERCADOPAGO_ACCESS_TOKEN=TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MERCADOPAGO_PUBLIC_KEY=TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MERCADOPAGO_WEBHOOK_SECRET=troque-por-um-segredo-do-webhook

# E-mail (SMTP)
SMTP_HOST=smtp.exemplo.com
SMTP_PORT=587
SMTP_USER=usuario
SMTP_PASS=senha
SMTP_FROM="Dravennx <naoresponda@dravennx.com.br>"

# Frete — Uber Flash e 99 são apps externos de corrida: o cliente pede e paga
# a corrida direto no app, a loja não define nem cobra esse valor (por isso
# não há variável de preço aqui). "Combinar com o vendedor" usa o WhatsApp
# configurado em STORE_WHATSAPP_NUMBER, abaixo.

# WhatsApp da loja — usado pelo botão "Falar no WhatsApp" que aparece quando
# o cliente escolhe frete "Combinar com o vendedor". Formato: código do país
# + DDD + número, só dígitos (ex.: 5585999998888 para +55 85 99999-8888).
STORE_WHATSAPP_NUMBER=

# Armazenamento de imagens (produto, banner, Instagram) — sem essas
# variáveis, o upload cai automaticamente no disco local (bom pra
# desenvolvimento, mas não sobrevive a um novo deploy na maioria dos
# provedores de hospedagem). Pra produção, configure um bucket
# S3-compatível — Cloudflare R2 é a opção recomendada (10GB grátis/mês,
# sem cobrar pra servir as imagens):
#   S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
#   S3_BUCKET=dravennx-uploads
#   S3_ACCESS_KEY_ID=... (gerado no painel do R2)
#   S3_SECRET_ACCESS_KEY=...
#   S3_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev  (ou seu domínio próprio)
#   S3_REGION=auto
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
S3_REGION=auto

# Monitoramento de erro em produção (opcional, mas recomendado) — crie um
# projeto gratuito em https://sentry.io e cole o DSN aqui. Sem essa
# variável, o sistema funciona normalmente, só sem avisar automaticamente
# quando algo quebrar (erros continuam aparecendo no log do servidor).
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# Frete real por CEP (Melhor Envio) — opcional. Sem essas variáveis, a loja
# segue funcionando normalmente só com as três opções fixas (Uber Flash, 99,
# combinar). Integração gratuita — crie uma conta em melhorenvio.com.br,
# gere um token de aplicação no painel (Configurações > Tokens) e informe o
# CEP de origem (endereço de onde os pedidos saem).
MELHOR_ENVIO_TOKEN=
STORE_POSTAL_CODE=
# 'false' usa o ambiente de produção; qualquer outro valor (ou omitido) usa
# o sandbox, que não gera cobrança real nem etiqueta de verdade — bom pra
# testar antes de ativar de vez.
MELHOR_ENVIO_SANDBOX=true
MELHOR_ENVIO_USER_AGENT=Dravennx (contato@dravennx.com.br)
